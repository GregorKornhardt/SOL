cff-version: 1.2.0
message: "If you use this software, please cite the SOL paper below."
title: "SOL: Sliced Optimal Transport for Language"
type: software
version: 0.1.1
authors:
  - family-names: Kornhardt
    given-names: Gregor
  - family-names: Piening
    given-names: Moritz
  - family-names: Chemseddine
